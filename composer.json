{
    "name": "alveby/atrium-brands",
    "description": "Brands for Atrium: a directory of makers with logos, colours and websites",
    "type": "atrium-module",
    "license": "MIT",
    "homepage": "https://github.com/AlveBy/atrium",
    "support": {
        "issues": "https://github.com/AlveBy/atrium/issues",
        "source": "https://github.com/AlveBy/atrium"
    },
    "keywords": [
        "laravel",
        "admin",
        "cms",
        "brands"
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "alveby/atrium": "^0.1"
    },
    "require-dev": {
        "alveby/atrium-theme": "^0.1",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Atrium\\Brands\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atrium\\Brands\\Tests\\": "tests/"
        }
    },
    "extra": {
        "atrium": {
            "resources": [
                "Atrium\\Brands\\Models\\Brand"
            ],
            "migrations": "database/migrations",
            "demo": "Atrium\\Brands\\Database\\BrandsDemoSeeder"
        },
        "laravel": {
            "providers": [
                "Atrium\\Brands\\BrandsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
